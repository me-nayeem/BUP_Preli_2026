{
  "name": "gridwise-llm",
  "version": "1.0.0",
  "private": true,
  "description": "GridWise LLM-assisted campus energy optimization API (BUP CSE Fest 2026 preliminary)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:notes": "node test/eval/notes.eval.js",
    "eval:samples": "node test/eval/samples.eval.js",
    "llm:smoke": "node scripts/llm-smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.22.3",
    "highs": "^1.15.3"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
